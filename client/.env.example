# FoodMaxx Production Environment Configuration
# Paystack Public Key (Card, Bank Transfer, USSD payments)
VITE_PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SMS Provider Selection ('termii' | 'native' | 'twilio')
VITE_SMS_PROVIDER=termii

# Termii Nigeria SMS Gateway (Recommended: DND Bypass & ₦3.80 GSM rates)
VITE_TERMII_API_KEY=TLxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_TERMII_SENDER_ID=FoodMaxx
VITE_TERMII_CHANNEL=generic

# Twilio SMS Gateway Configuration (Alternative)
VITE_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_TWILIO_FROM_NUMBER=+1234567890
